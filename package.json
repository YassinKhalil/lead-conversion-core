{
  "name": "lead-conversion-core",
  "version": "0.4.0",
  "private": true,
  "description": "Active low-latency conversation runtime for direct Lead Conversion OS testing",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker-runner.js",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "seed": "tsx scripts/seed.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "user:create": "tsx scripts/create-dashboard-user.ts",
    "user:create:prod": "node dist/scripts/create-dashboard-user.js",
    "calendar:reconcile": "tsx scripts/calendar-reconcile.ts",
    "calendar:reconcile:prod": "node dist/scripts/calendar-reconcile.js",
    "dump:inspect": "scripts/ops/inspect-dump-metadata.sh",
    "dump:restore-smoke": "scripts/ops/restore-dump-smoke.sh",
    "artifacts:scan": "scripts/ops/scan-tracked-artifacts.sh",
    "config": "tsx scripts/config.ts",
    "config:prod": "node dist/scripts/config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "tsx scripts/smoke-engine.ts",
    "simulate": "tsx scripts/simulate-conversation.ts",
    "test:integration": "tsx scripts/smoke-integration.ts",
    "backup:postgres": "scripts/backup/backup-postgres.sh",
    "restore:postgres": "scripts/backup/restore-postgres.sh",
    "tenant:hospitality": "tsx scripts/provision-hospitality-tenant.ts",
    "tenant:hospitality:prod": "node dist/scripts/provision-hospitality-tenant.js",
    "tenant:clinic": "tsx scripts/provision-clinic-tenant.ts",
    "tenant:clinic:prod": "node dist/scripts/provision-clinic-tenant.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@node-rs/argon2": "^2.1.0",
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
