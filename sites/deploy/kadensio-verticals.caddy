# real-estate., hospitality. and clinic.kadensio.com (static sites, built by sites/build.mjs).
# Installed to /etc/caddy/sites/ by sites/deploy/publish.sh once DNS resolves.

(kadensio_static) {
	encode zstd gzip
	# Hashed names (sites/fingerprint.mjs) never change content: cache for a year.
	# Everything else, HTML included, revalidates. No response is left without a
	# Cache-Control, so a proxy cannot invent a lifetime for it.
	@hashed path_regexp \.[0-9a-f]+\.(css|js|woff2|svg|png|jpg|jpeg|webp|ico)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@mutable not path_regexp \.[0-9a-f]+\.(css|js|woff2|svg|png|jpg|jpeg|webp|ico)$
	header @mutable Cache-Control "no-cache"
}

real-estate.kadensio.com {
	import umami_collect
	# The waitlist form on the landing posts here; the API serves it at /public/waitlist.
	handle /api/waitlist {
		rewrite * /public/waitlist
		reverse_proxy 127.0.0.1:8084
	}

	# The "Try it now" demo on the landing. Stateless: runs the engine and scorer, stores nothing.
	handle /api/demo/turn {
		rewrite * /public/demo/turn
		reverse_proxy 127.0.0.1:8084
	}

	# Company-level legal pages live on kadensio.com.
	redir /privacy.html https://kadensio.com/privacy.html 301
	redir /terms.html https://kadensio.com/terms.html 301
	redir /dpa.html https://kadensio.com/dpa.html 301

	handle {
		root * /var/www/kadensio-real-estate/current
		file_server
		import kadensio_static
	}
}

